# Frontend (Vite). Leave unset to run on the built-in demo dataset.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge function secrets — set with `supabase secrets set`, never in the frontend:
#   CRON_SECRET                    shared secret pg_cron sends to the sync functions
#   WHOOP_CLIENT_ID                from the Whoop developer app
#   WHOOP_CLIENT_SECRET
#   WHOOP_REDIRECT_URI             https://<PROJECT_REF>.supabase.co/functions/v1/whoop-sync
#   GOOGLE_SERVICE_ACCOUNT_JSON    service-account key file contents, verbatim
#   GOOGLE_CALENDAR_ID             calendar to scan (usually your email)
#   THERAPY_KEYWORDS               optional, comma-separated event-name matches
#   PHYSIO_KEYWORDS                optional
#   BLOG_FEED_URL                  optional; omit to use paste-per-ship
